# Engine Room runtime
NODE_ENV=development
ENGINE_ROOM_BASE_URL=http://localhost:3000
LOG_LEVEL=info
DATABASE_URL=postgresql://engine_room:engine_room@localhost:5432/engine_room
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_INSTALLATION_ID=
GITHUB_API_BASE_URL=https://api.github.com
# Use a random 32+-character secret stored in the deployment secret manager.
ENGINE_ROOM_ADMIN_TOKEN=
ENGINE_ROOM_TELEMETRY_KEYS=[]

# Optional no-new-worker-cost public GitHub bootstrap and refresh while the web process is active.
# Anonymous: every two hours. With server-side GITHUB_READ_TOKEN: every 15 minutes.
# For near-instant PRs configure signed GitHub App webhooks and durable reconciliation.
ENGINE_ROOM_PUBLIC_GITHUB_SYNC=1
ENGINE_ROOM_GITHUB_OWNER=neophilism
GITHUB_READ_TOKEN=
# Optional server-only live Render deployment API refresh.
RENDER_API_KEY=
