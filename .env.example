# Engine Room runtime
NODE_ENV=development
ENGINE_ROOM_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL is optional for static/build-time work and required for database operations.
DATABASE_URL=postgresql://engine_room:engine_room@localhost:5432/engine_room

# GitHub App integration. Keep the PEM key and webhook secret outside source control.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com
